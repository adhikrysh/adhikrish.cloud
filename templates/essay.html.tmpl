<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{TITLE}} | adhikrish rk</title>
<meta name="description" content="{{DESCRIPTION}}">
<meta property="og:title" content="{{TITLE}} | adhikrish rk">
<meta property="og:description" content="{{DESCRIPTION}}">
<meta property="og:image" content="https://adhikrish.cloud/og.png">
<meta property="og:type" content="article">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://adhikrish.cloud/og.png">
<meta name="theme-color" content="#080807">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="icon" type="image/webp" href="/assets/favicon-a54222d526e5.webp">
<link rel="preload" href="/assets/inter-latin-c940764593d0.woff2" as="font" type="font/woff2" crossorigin>
<link rel="canonical" href="https://adhikrish.cloud/essays/{{SLUG}}">
<style>

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 300 700;
    font-display: swap;
    src: url('/assets/inter-latin-c940764593d0.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  ::selection { background: rgba(255, 100, 0, 0.25); }
  body {
    background: #080807;
    color: #d8d4c8;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    font-size: 17px;
    font-weight: 380;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.6;
    letter-spacing: -0.012em;
    padding: 40px 28px 80px;
  }
  .reading { max-width: 680px; margin-inline: auto; }
  nav { display: flex; gap: 18px; }
  nav a { color: #8a8a8a; font-size: 16px; }
  a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; transition: color 220ms ease; }
  a:hover { color: #787878; }
  a:focus-visible { outline: 1px solid #d8d4c8; outline-offset: 5px; }
  main, article { margin-top: 56px; }
  h1 { font-size: 24px; font-weight: 450; line-height: 1.3; letter-spacing: -0.024em; }
  @media (max-width: 720px) {
    body { padding-top: 32px; font-size: 16px; }
    nav a { font-size: 15px; }
    main, article { margin-top: 48px; }
  }
  @media (max-width: 360px) {
    body { padding-inline: 20px; }
    nav a { font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
  .essay h1 { font-size: 28px; }
  .essay-meta { color: #8a8a8a; font-size: 13px; margin-top: 12px; }
  .last-edited { display: block; font-size: 12px; margin-top: 4px; }
  .essay-body { margin-top: 40px; line-height: 1.8; }
  .essay-body p { margin-block: 20px; }
  .essay-body > :first-child { margin-top: 0; }
  .essay-body a { color: #8a8a8a; overflow-wrap: anywhere; }
  .essay-body a:hover { color: #787878; }
</style>
</head>
<body>
  <div class="reading">
    <nav aria-label="site"><a href="/">home</a><a href="/essays">essays</a></nav>
    <main class="essay">
      <h1>{{TITLE}}</h1>
      <p class="essay-meta">
        <time datetime="{{DATE_ISO}}">{{DATE}}</time>
        <span class="last-edited">last edited <time datetime="{{EDITED_DATE_ISO}}">{{EDITED_DATE}}</time></span>
      </p>
      <div class="essay-body">
        {{BODY_HTML}}
      </div>
    </main>
  </div>
</body>
</html>
