    "name": "decision",
    "type": "text",
    "required": true
   },
   {
    "name": "rationale",
    "type": "text"
   },
   {
    "name": "confidence",
    "type": "int",
    "min": 0,
    "max": 100,
    "unit": "%"
   },
   {
    "name": "expected",
    "type": "text"
   },
   {
    "name": "review_date",
    "type": "date"
   },
   {
    "name": "outcome",
    "type": "text"
   },
   {
    "name": "verdict",
    "type": "enum",
    "options": [
     "right",
     "wrong"
    ],
    "colors": {
     "right": "good",
     "wrong": "bad"
    }
   },
   {
    "name": "status",
    "type": "enum",
    "options": [
     "open",
     "closed"
    ],
    "colors": {
     "closed": "outline"
    }
   }
  ],
  "views": [
   {
    "kind": "upcoming",
    "field": "review_date",
    "where": {
     "status": "open"
    },
    "limit": 3
   },
   {
    "kind": "calibration",
    "confidence": "confidence",
    "verdict": "verdict",
    "right": "right",
    "min": 10
   }
  ]
 },
