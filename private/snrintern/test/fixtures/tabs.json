 "health": {
  "label": "health",
  "about": "garmin, every day: recovery, sleep, activity, fitness",
  "title": "date",
  "aside": [
   "sleep_min",
   "hrv_ms",
   "steps"
  ],
  "line": [],
  "sort": "date",
  "parts": [
   {
    "label": "sleep",
    "fields": [
     "sleep_deep_min",
     "sleep_light_min",
     "sleep_rem_min",
     "sleep_awake_min"
    ]
   },
   {
    "label": "stress",
    "fields": [
     "stress_rest_min",
     "stress_low_min",
     "stress_medium_min",
     "stress_high_min"
    ]
   }
  ],
  "views": [
   {
    "kind": "metrics",
    "label": "recovery",
    "metrics": [
     {
      "field": "resting_hr",
      "better": "lower",
      "limit": 100,
      "stream": "heart rate",
      "log": {
       "good": "well recovered",
       "bad": "under-recovered"
      }
     },
     {
      "field": "hrv_ms",
      "label": {
       "field": "hrv_status",
       "bad": [
        "low",
        "poor",
        "unbalanced"
       ]
      },
      "stream": "overnight hrv",
      "log": {
       "bad": "under-recovered"
      }
     },
     {
      "field": "body_battery_at_wake",
      "scale": [
       {
        "upTo": 25,
        "word": "very low",
        "tone": "bad"
       },
       {
        "upTo": 50,
        "word": "low",
        "tone": "bad"
       },
       {
        "upTo": 75,
        "word": "medium"
       },
       {
        "upTo": 100,
        "word": "high",
        "tone": "good"
       }
      ],
      "stream": "body battery",
      "log": {
       "good": "well recovered",
       "bad": "under-recovered"
      }
     }
    ]
   },
   {
    "kind": "metrics",
    "label": "sleep",
    "metrics": [
     {
      "field": "sleep_score",
      "label": {
       "field": "sleep_score_label",
       "good": [
        "excellent"
       ],
       "bad": [
        "poor"
       ]
      },
      "log": {
       "good": "slept well",
       "bad": "poor sleep"
      }
     },
     {
      "field": "stress_avg",
      "scale": [
       {
        "upTo": 25,
        "word": "rest",
        "tone": "good"
       },
       {
        "upTo": 50,
        "word": "low"
       },
       {
        "upTo": 75,
        "word": "medium",
        "tone": "bad"
       },
       {
        "upTo": 100,
        "word": "high",
        "tone": "bad"
       }
      ],
      "log": {
       "good": "calm day",
       "bad": "stressful day"
      }
     }
    ]
   },
   {
    "kind": "metrics",
    "label": "activity",
    "metrics": [
     {
      "field": "steps",
      "goal": "step_goal",
      "finished": true,
      "log": {
       "good": "active day"
      }
     },
     {
      "field": "intensity_min",
      "goal": "intensity_goal",
      "per": "week",
      "finished": true
     }
    ]
   },
   {
    "kind": "metrics",
    "label": "fitness",
    "metrics": [
     {
      "field": "vo2max",
      "better": "higher",
      "change": true
     },
     {
      "field": "fitness_age",
      "better": "lower",
      "change": true
     },
     {
      "field": "weight_kg",
      "change": true
     }
    ]
   }
  ],
