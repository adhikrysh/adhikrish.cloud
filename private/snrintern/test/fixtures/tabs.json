 "forecasts": {
  "label": "forecasts",
  "about": "predictions to be scored later",
  "title": "decision",
  "aside": [
   "verdict",
   "status"
  ],
  "line": [
   "confidence",
   "review_date"
  ],
  "sort": "date",
  "fields": [
   {
    "name": "date",
    "type": "date"
   },
